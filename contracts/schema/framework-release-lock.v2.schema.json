{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:simai:framework-contract-registry:release-lock:2",
  "title": "Simai Framework bounded release lock, v2 (one ui build commit)",
  "description": "A Framework release is one simai/ui build commit; compatibility_id is ui-<first 12 hex of it>. Core and Smart are both published from simai/ui, at distr and distr/smart. While simai/ui-smart is kept as a mirror for v1 readers, `mirror` names the ui-smart commit carrying the same Smart bytes and `pair` the v1-shaped id ui-<12>-smart-<12>, under which a v1 alias lock is also written. v1 locks keep framework-release-lock.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "compatibility_id",
    "status",
    "profile",
    "runtime_sources",
    "build_inputs",
    "inventory",
    "exclusions",
    "claims"
  ],
  "dependentRequired": {
    "mirror": [
      "pair"
    ],
    "pair": [
      "mirror"
    ]
  },
  "properties": {
    "schema_id": {
      "const": "simai.framework.release-lock"
    },
    "schema_version": {
      "const": 2
    },
    "compatibility_id": {
      "type": "string",
      "pattern": "^ui-[0-9a-f]{12}$"
    },
    "status": {
      "const": "bounded"
    },
    "profile": {
      "const": "plain-assets-v1"
    },
    "runtime_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core",
        "smart"
      ],
      "properties": {
        "core": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "tag",
            "tag_object",
            "revision",
            "commit",
            "tree",
            "runtime_path",
            "runtime_tree",
            "archive_sha256"
          ],
          "properties": {
            "owner": {
              "const": "simai/ui"
            },
            "tag": {
              "const": null
            },
            "tag_object": {
              "const": null
            },
            "revision": {
              "$ref": "#/$defs/sha1",
              "description": "The release: the ui build commit this lock is named after. The same for both trees."
            },
            "commit": {
              "$ref": "#/$defs/sha1",
              "description": "The build commit that last wrote runtime_path as of revision (git log -1 revision -- runtime_path). Consumers resolve a release by it. tree, runtime_tree and archive_sha256 are taken at this commit."
            },
            "tree": {
              "$ref": "#/$defs/sha1"
            },
            "runtime_path": {
              "const": "distr"
            },
            "runtime_tree": {
              "$ref": "#/$defs/sha1"
            },
            "archive_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "smart": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "tag",
            "tag_object",
            "revision",
            "commit",
            "tree",
            "runtime_path",
            "runtime_tree",
            "archive_sha256"
          ],
          "properties": {
            "owner": {
              "const": "simai/ui"
            },
            "tag": {
              "const": null
            },
            "tag_object": {
              "const": null
            },
            "revision": {
              "$ref": "#/$defs/sha1",
              "description": "The release: the ui build commit this lock is named after. The same for both trees."
            },
            "commit": {
              "$ref": "#/$defs/sha1",
              "description": "The build commit that last wrote runtime_path as of revision (git log -1 revision -- runtime_path). Consumers resolve a release by it. tree, runtime_tree and archive_sha256 are taken at this commit."
            },
            "tree": {
              "$ref": "#/$defs/sha1"
            },
            "runtime_path": {
              "const": "distr/smart"
            },
            "runtime_tree": {
              "$ref": "#/$defs/sha1"
            },
            "archive_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "mirror": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "tag",
        "tag_object",
        "commit",
        "tree",
        "runtime_path",
        "runtime_tree",
        "archive_sha256",
        "mirrors"
      ],
      "description": "The ui-smart copy of distr/smart. runtime_tree equals runtime_sources.smart.runtime_tree: the two trees are byte-identical.",
      "properties": {
        "owner": {
          "const": "simai/ui-smart"
        },
        "tag": {
          "const": null
        },
        "tag_object": {
          "const": null
        },
        "commit": {
          "$ref": "#/$defs/sha1",
          "description": "The ui-smart build commit that last wrote smart."
        },
        "tree": {
          "$ref": "#/$defs/sha1"
        },
        "runtime_path": {
          "const": "smart"
        },
        "runtime_tree": {
          "$ref": "#/$defs/sha1"
        },
        "archive_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mirrors": {
          "const": "smart"
        }
      }
    },
    "pair": {
      "type": "string",
      "pattern": "^ui-[0-9a-f]{12}-smart-[0-9a-f]{12}$",
      "description": "ui-<release 12>-smart-<mirror commit 12>; written only while a mirror exists."
    },
    "build_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "builder",
        "legacy_compatibility"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/repositoryInput"
        },
        "builder": {
          "$ref": "#/$defs/repositoryInput"
        },
        "legacy_compatibility": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "required"
              ],
              "properties": {
                "required": {
                  "const": false
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "required",
                "source",
                "lineage_manifest",
                "invocation"
              ],
              "properties": {
                "required": {
                  "const": true
                },
                "source": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/repositoryInput"
                    },
                    {
                      "type": "object",
                      "required": [
                        "runtime_path",
                        "runtime_tree"
                      ],
                      "properties": {
                        "runtime_path": {
                          "const": "distr"
                        },
                        "runtime_tree": {
                          "$ref": "#/$defs/sha1"
                        }
                      }
                    }
                  ]
                },
                "lineage_manifest": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "owner",
                    "commit",
                    "tree",
                    "path",
                    "blob",
                    "sha256",
                    "records_count"
                  ],
                  "properties": {
                    "owner": {
                      "enum": [
                        "simai/ui-control",
                        "simai/ui"
                      ]
                    },
                    "commit": {
                      "$ref": "#/$defs/sha1"
                    },
                    "tree": {
                      "$ref": "#/$defs/sha1"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "blob": {
                      "$ref": "#/$defs/sha1"
                    },
                    "sha256": {
                      "$ref": "#/$defs/sha256"
                    },
                    "records_count": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                "invocation": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "command",
                    "arguments",
                    "environment_bindings"
                  ],
                  "properties": {
                    "command": {
                      "const": "node scripts/verify-product-reproducibility.cjs"
                    },
                    "arguments": {
                      "type": "array",
                      "contains": {
                        "const": "--require-legacy-compatibility"
                      }
                    },
                    "environment_bindings": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "SF_LEGACY_COMPATIBILITY_ROOT",
                        "SF_LEGACY_COMPATIBILITY_REVISION",
                        "SF_LEGACY_COMPATIBILITY_MANIFEST"
                      ]
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "inventory": {
      "type": "object"
    },
    "exclusions": {
      "type": "array"
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_compatible",
        "production_ready",
        "all_items_ready"
      ],
      "properties": {
        "full_compatible": {
          "const": false
        },
        "production_ready": {
          "const": false
        },
        "all_items_ready": {
          "const": false
        }
      }
    },
    "unit_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "path",
        "sha256",
        "units",
        "change_report"
      ],
      "description": "simai.linkage 1.0.0: the release's unit inventory beside this lock (contracts/releases/<compatibility_id>.inventory.json) and its change report against the previous released inventory. Optional and additive.",
      "properties": {
        "schema": {
          "const": "simai.framework.unit-inventory"
        },
        "path": {
          "type": "string",
          "pattern": "^contracts/releases/ui-[0-9a-f]{12}\\.inventory\\.json$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "units": {
          "type": "integer",
          "minimum": 1
        },
        "change_report": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256",
                "from"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^contracts/releases/ui-[0-9a-f]{12}\\.changes\\.json$"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "from": {
                  "type": "string",
                  "pattern": "^ui-[0-9a-f]{12}$"
                }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repositoryInput": {
      "type": "object",
      "required": [
        "owner",
        "commit",
        "tree",
        "archive_sha256"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^simai/[a-z0-9-]+$"
        },
        "commit": {
          "$ref": "#/$defs/sha1"
        },
        "tree": {
          "$ref": "#/$defs/sha1"
        },
        "archive_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
