{
  "custom-properties": {},
  "class-properties": {
    ".sf-menu .sf-menu-item": {
      "--sf-menu-item--background-color": "transparent",
      "--sf-menu-item--gap": "var(--sf-a1)"
    },
    ".sf-menu-element": {
      "--sf-menu-element--background-color": "var(--sf-transparent)",
      "--sf-menu-element--border-color": "var(--sf-surface-container)",
      "--sf-menu-element--color": "var(--sf-on-surface)"
    },
    ".sf-menu-element .sf-menu-element-wrap": {
      "--sf-menu-element-wrap--background-color": "transparent",
      "--sf-menu-element-wrap--gap": "var(--sf-space-1\\/3)",
      "--sf-menu-element-wrap--padding-bottom": "var(--sf-space-1\\/4)",
      "--sf-menu-element-wrap--padding-top": "var(--sf-space-1\\/4)"
    },
    ".sf-menu-element--level-1": {
      "--sf-menu-element--padding-inline-start": "var(--sf-space-1)"
    },
    ".sf-menu-element--level-2": {
      "--sf-menu-element--padding-inline-start": "var(--sf-space-3)"
    },
    ".sf-menu-element--level-3": {
      "--sf-menu-element--padding-inline-start": "var(--sf-space-4)"
    },
    ".sf-menu-element--level-4": {
      "--sf-menu-element--padding-inline-start": "var(--sf-space-5)"
    },
    ".sf-menu-element.disabled": {
      "--sf-menu-element--background-color": "var(--sf-disable)",
      "--sf-menu-element--border-color": "var(--sf-outline-disable)",
      "--sf-menu-element--color": "var(--sf-on-disable)"
    },
    ".sf-menu-element.disabled .sf-icon": {
      "--sf-icon--color": "var(--sf-menu-element--color)"
    },
    ".sf-menu-element.open": {
      "--sf-menu-element--background-color": "var(--sf-surface-container-active)",
      "--sf-menu-element--border-color": "var(--sf-surface-container-active)"
    },
    ".sf-menu-element.open .sf-icon": {
      "--sf-icon--color": "var(--sf-on-surface-variant)"
    },
    ".sf-menu-element.sf-menu-element--level-1.disabled .sf-icon": {
      "--sf-icon--color": "var(--sf-on-disable)"
    },
    ".sf-menu-element.sf-menu-element--level-2.disabled .sf-icon": {
      "--sf-icon--color": "var(--sf-on-disable)"
    },
    ".sf-menu-element.sf-menu-element--level-3.disabled .sf-icon": {
      "--sf-icon--color": "var(--sf-on-disable)"
    },
    ".sf-menu-element.sf-menu-element--level-4.disabled .sf-icon": {
      "--sf-icon--color": "var(--sf-on-disable)"
    },
    ".sf-menu-element:not(:disabled):not(.disabled):hover": {
      "--sf-menu-element--background-color": "var(--sf-surface-container-hover)",
      "--sf-menu-element--border-color": "var(--sf-surface-container-hover)"
    },
    ".sf-menu-element:not(:disabled):not(.disabled):hover .sf-icon": {
      "--sf-icon--color": "var(--sf-on-surface-variant)"
    },
    ".sf-menu-secondary .sf-menu-element.sf-menu-subchild": {
      "--sf-menu-element--padding-inline-start": "var(--sf-space-6)"
    }
  },
  "all-classes": [
    ".disabled",
    ".open",
    ".sf-icon",
    ".sf-menu",
    ".sf-menu-divider",
    ".sf-menu-element",
    ".sf-menu-element--level-1",
    ".sf-menu-element--level-2",
    ".sf-menu-element--level-3",
    ".sf-menu-element--level-4",
    ".sf-menu-element-wrap",
    ".sf-menu-item",
    ".sf-menu-secondary",
    ".sf-menu-subchild"
  ]
}