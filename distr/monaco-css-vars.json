{
  "custom-properties": {},
  "class-properties": {
    ".sf-theme-builder": {
      "--sf-theme-builder-drop-preview-height": "var(--sf-space-d8, 140px)",
      "--sf-theme-builder-input-min-width": "var(--sf-space-d6, 120px)",
      "--sf-theme-builder-menu-btn-padding": "var(--sf-space-d1, 6px) var(--sf-space-d2, 8px)",
      "--sf-theme-builder-menu-padding": "var(--sf-space-d2, 8px)",
      "--sf-theme-builder-menu-width": "var(--sf-space-d7, 140px)",
      "--sf-theme-builder-modal-padding": "var(--sf-space-d4, 16px)",
      "--sf-theme-builder-panel-radius": "var(--sf-radius-2, 18px)",
      "--sf-theme-builder-preview-min": "var(--sf-space-d4, 32px)",
      "--sf-theme-builder-section-columns": "1fr var(--sf-space-d6, 120px)",
      "--sf-theme-builder-tabs-radius": "var(--sf-radius-1, 12px)",
      "--sf-theme-builder-tiles-min": "46px",
      "--sf-theme-builder-translate-up": "-18px"
    }
  },
  "all-classes": [
    ".is-open",
    ".sf-theme-builder",
    ".sf-theme-builder--drawer",
    ".sf-theme-builder--drawer-init",
    ".sf-theme-builder__drawer-overlay",
    ".sf-theme-builder__drop-preview",
    ".sf-theme-builder__input",
    ".sf-theme-builder__modal",
    ".sf-theme-builder__modal-preview",
    ".sf-theme-builder__palette-item",
    ".sf-theme-builder__palette-menu",
    ".sf-theme-builder__section-body",
    ".sf-theme-builder__swatch",
    ".sf-theme-builder__tonal-grid"
  ]
}