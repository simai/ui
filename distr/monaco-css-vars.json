{
  "custom-properties": {},
  "class-properties": {
    ".sf-icon-button.sf-button-pinned .sf-icon": {
      "--sf-button-pinned--color": "var(--sf-primary)",
      "--sf-icon--color": "var(--sf-button-pinned--color)"
    },
    ".sf-modal-panel .sf-modal-surface": {
      "--sf-modal-surface--padding-inline-end": "0",
      "--sf-modal-surface--padding-inline-start": "0",
      "--sf-modal-surface-radius": "0"
    },
    ".sf-table-context-menu .sf-context-menu-columns": {
      "--sf-context-menu-columns--padding-bottom": "var(--sf-space-2)",
      "--sf-context-menu-columns--padding-inline-end": "var(--sf-space-2)",
      "--sf-context-menu-columns--padding-inline-start": "var(--sf-space-2)",
      "--sf-context-menu-columns--padding-top": "var(--sf-space-2)"
    },
    ".sf-table-context-menu .sf-context-menu-content": {
      "--sf-context-menu-content--padding-bottom": "0",
      "--sf-context-menu-content--padding-inline-end": "0",
      "--sf-context-menu-content--padding-inline-start": "0",
      "--sf-context-menu-content--padding-top": "0"
    },
    ".sf-table-context-menu .sf-settings-context-menu-item .sf-icon-button": {
      "--sf-icon-button--padding-bottom": "var(--sf-ui-1\\/2--space-y-tightness-default)",
      "--sf-icon-button--padding-inline-end": "var(--sf-ui-1\\/2--space-y-tightness-default)",
      "--sf-icon-button--padding-inline-start": "var(--sf-ui-1\\/2--space-y-tightness-default)",
      "--sf-icon-button--padding-top": "var(--sf-ui-1\\/2--space-y-tightness-default)"
    },
    ".sf-table-context-menu .sf-table-context-bottom": {
      "--sf-table-context-bottom--padding-bottom": "var(--sf-space-2)",
      "--sf-table-context-bottom--padding-inline-end": "var(--sf-space-2)",
      "--sf-table-context-bottom--padding-inline-start": "var(--sf-space-2)"
    },
    ".sf-table-context-menu .sf-table-context-main": {
      "--sf-table-context-main--padding-inline-end": "var(--sf-space-2)",
      "--sf-table-context-main--padding-inline-start": "var(--sf-space-2)"
    },
    ".sf-table-context-menu .sf-table-context-top": {
      "--sf-table-context-top--padding-inline-end": "var(--sf-space-2)",
      "--sf-table-context-top--padding-inline-start": "var(--sf-space-2)",
      "--sf-table-context-top--padding-top": "var(--sf-space-2)"
    },
    ".sf-table-context-menu .sf-tabs-main-container": {
      "--sf-tabs-main-container--padding-bottom": "0",
      "--sf-tabs-main-container--padding-top": "0"
    },
    ".sf-table-context-menu .sf-tabs-top-container": {
      "--sf-tabs-top-container--padding-inline-end": "var(--sf-space-2)",
      "--sf-tabs-top-container--padding-inline-start": "var(--sf-space-2)",
      "--sf-tabs-top-container--padding-top": "var(--sf-space-2)"
    },
    "sf-table\r\n  > *\r\n  .sf-search-input.sf-input.sf-input--size-1\r\n  .sf-icon-button--size-1": {
      "--sf-icon-button--padding-bottom": "var(\r\n            --sf-ui-1\\/3--space-y-tightness-default\r\n    )",
      "--sf-icon-button--padding-inline-end": "var(\r\n            --sf-ui-1\\/3--space-y-tightness-default\r\n    )",
      "--sf-icon-button--padding-inline-start": "var(\r\n            --sf-ui-1\\/3--space-y-tightness-default\r\n    )",
      "--sf-icon-button--padding-top": "var(--sf-ui-1\\/3--space-y-tightness-default)"
    },
    "sf-table > * .sf-search-input.sf-input.sf-input--size-1 .sf-input-field": {
      "--sf-input-field--padding-bottom": "var(\r\n            --sf-ui-1\\/3--space-y-tightness-default\r\n    )",
      "--sf-input-field--padding-top": "var(--sf-ui-1\\/3--space-y-tightness-default)"
    },
    "sf-table > .sf-table thead th[data-key=\"actions\"]": {
      "--sf-table--actions-column-width": "var(--sf-f0)"
    },
    "sf-table > .sf-table thead th[data-key=\"select\"]": {
      "--sf-table--select-column-width": "var(--sf-text-height-1)"
    },
    "sf-table > .sf-table thead th[data-key=\"settings\"]": {
      "--sf-table--settigs-column-width": "calc(var(--sf-text-height-1) + var(--sf-ui-1--space-y-tightness-default))"
    }
  },
  "all-classes": [
    ".drag-placeholder",
    ".edited",
    ".hover",
    ".is-column-drag-after",
    ".is-column-drag-before",
    ".is-column-dragging",
    ".is-dragging",
    ".is-resizing",
    ".is-resizing-backward",
    ".is-resizing-forward",
    ".sf-admin-panel-bottom",
    ".sf-admin-panel-head",
    ".sf-avatar-label-group-container",
    ".sf-avatar-label-group-title",
    ".sf-button-pinned",
    ".sf-context-menu-columns",
    ".sf-context-menu-content",
    ".sf-icon",
    ".sf-icon-button",
    ".sf-icon-button--size-1",
    ".sf-input",
    ".sf-input--size-1",
    ".sf-input-field",
    ".sf-modal-panel",
    ".sf-modal-surface",
    ".sf-search-input",
    ".sf-settings-context-menu-item",
    ".sf-table",
    ".sf-table-avatar",
    ".sf-table-column-drag-ghost",
    ".sf-table-column-dragging",
    ".sf-table-column-resizing",
    ".sf-table-context-bottom",
    ".sf-table-context-main",
    ".sf-table-context-menu",
    ".sf-table-context-top",
    ".sf-table-detail-field",
    ".sf-tabs-main-container",
    ".sf-tabs-top-container",
    ".table"
  ]
}