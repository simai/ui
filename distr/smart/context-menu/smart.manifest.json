{
  "schema_version": 2,
  "id": "smart.context-menu",
  "version": "1.1.0",
  "title": "Context Menu",
  "summary": "The Framework's action menu: data entries with icon, caption, value, shortcut, check, submenu, separator and heading, opened by openFor() into the top layer, anchored, with keyboard, typeahead and focus return. A host may still render its own items and own the lifecycle.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "context-menu"
  ],
  "capabilities": [
    "render",
    "theme",
    "responsive"
  ],
  "custom_element": "sf-context-menu",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "component.context-menu",
      "smart.buttons"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "required": [
      "aria-label"
    ],
    "properties": {
      "template": {
        "type": "string",
        "default": "default",
        "enum": [
          "default"
        ]
      },
      "position": {
        "type": "string",
        "default": "",
        "enum": [
          "",
          "inline-start",
          "inline-start-top",
          "inline-start-bottom",
          "inline-end",
          "inline-end-top",
          "inline-end-bottom",
          "top",
          "top-inline-start",
          "top-inline-end",
          "bottom",
          "bottom-inline-start",
          "bottom-inline-end",
          "start",
          "end",
          "top-start",
          "top-end",
          "bottom-start",
          "bottom-end",
          "left",
          "left-top",
          "left-bottom",
          "right",
          "right-top",
          "right-bottom",
          "top-left",
          "top-center",
          "top-right",
          "bottom-left",
          "bottom-center",
          "bottom-right",
          "left-start",
          "left-end",
          "right-start",
          "right-end",
          "inline-start-start",
          "inline-start-end",
          "inline-end-start",
          "inline-end-end"
        ]
      },
      "tooltip": {
        "type": "boolean",
        "default": true
      },
      "text": {
        "type": "string",
        "default": ""
      },
      "aria-label": {
        "type": "string",
        "default": ""
      },
      "items": {
        "type": "array",
        "default": [],
        "items": {
          "type": "object"
        }
      },
      "role": {
        "type": "string",
        "default": "menu"
      },
      "content-class": {
        "type": "string",
        "default": ""
      },
      "root-class": {
        "type": "string",
        "default": ""
      },
      "entries": {
        "type": "array",
        "default": [],
        "items": {
          "type": "object"
        },
        "description": "The menu as data (set as a property, or JSON in the attribute). See item_contract. When present, it replaces items and the content slot."
      },
      "popup": {
        "type": "boolean",
        "default": false,
        "description": "Not drawn until opened through openFor(). A menu without it is drawn in place, as before."
      }
    },
    "additionalProperties": false
  },
  "item_contract": {
    "summary": "One entry of `entries`.",
    "kinds": {
      "item": {
        "fields": {
          "id": "string, returned in sf-context-menu-select",
          "text": "string, the label",
          "icon": "string, a Material Symbols name",
          "caption": "string, a second line under the label",
          "value": "string, read-only value at the row's end",
          "shortcut": "string, shown at the row's end",
          "kind": "'check' | 'radio' for a checkable row",
          "checked": "boolean",
          "danger": "boolean, a destructive action",
          "disabled": "boolean",
          "current": "boolean, the place the person is",
          "href": "string, a link row",
          "submenu": "entries, opened beside the row",
          "keepOpen": "boolean, a choice does not close the menu"
        }
      },
      "separator": {
        "fields": {
          "type": "'separator'"
        }
      },
      "heading": {
        "fields": {
          "type": "'heading'",
          "text": "string, names the items under it"
        }
      }
    }
  },
  "contracts": {},
  "methods": {
    "focus": {
      "summary": "Focus the current available item. A host that renders the menu itself waits for rendering and owns opening and dismissal.",
      "arguments": [
        {
          "name": "options",
          "schema": {
            "type": "object"
          },
          "required": false
        }
      ],
      "returns": {
        "type": "null"
      }
    },
    "openFor": {
      "summary": "Open beside an element: top layer, anchored by SF.Position with flip and shift, focus on the first item (or 'last', or 'none'). The menu then owns its lifecycle: Escape, Tab, a press outside and a choice close it and return the focus.",
      "arguments": [
        {
          "name": "anchor",
          "type": "Element",
          "required": true
        },
        {
          "name": "options",
          "schema": {
            "type": "object",
            "properties": {
              "side": {
                "type": "string",
                "default": "block-end"
              },
              "align": {
                "type": "string",
                "default": "start"
              },
              "focus": {
                "type": "string",
                "enum": [
                  "first",
                  "last",
                  "none"
                ],
                "default": "first"
              }
            }
          },
          "required": false
        }
      ],
      "returns": {
        "type": "boolean",
        "description": "Whether it opened."
      }
    },
    "toggleFor": {
      "summary": "Close when already open for this anchor, otherwise openFor().",
      "arguments": [
        {
          "name": "anchor",
          "type": "Element",
          "required": true
        },
        {
          "name": "options",
          "schema": {
            "type": "object"
          },
          "required": false
        }
      ],
      "returns": {
        "type": "boolean"
      }
    },
    "close": {
      "summary": "Close this menu and any submenu.",
      "arguments": [
        {
          "name": "options",
          "schema": {
            "type": "object",
            "properties": {
              "restoreFocus": {
                "type": "boolean",
                "default": true
              }
            }
          },
          "required": false
        }
      ],
      "returns": {
        "type": "boolean",
        "description": "Whether it was open."
      }
    }
  },
  "events": {
    "sf-context-menu-select": {
      "summary": "An entry was chosen, at any depth. Cancel it to keep the menu open.",
      "payload": {
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "entry": {
            "type": "object"
          },
          "checked": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "The state a check or radio row asks for; null for a plain item."
          }
        }
      }
    },
    "sf-context-menu-open": {
      "summary": "Opened through openFor().",
      "payload": {
        "type": "object"
      }
    },
    "sf-context-menu-close": {
      "summary": "Closed.",
      "payload": {
        "type": "object"
      }
    }
  },
  "state": {
    "machines": {},
    "visual_states": [
      "default"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "component",
    "network_owner": "none",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-source",
    "data": "fixture",
    "effects": "component",
    "forbidden_client_responsibilities": [
      "backend access decisions",
      "host route invention"
    ]
  },
  "security": {
    "permissions_owner": "none",
    "untrusted_inputs": [
      "props",
      "children"
    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": "menu",
    "accessible_name": "required",
    "keyboard": [
      "ArrowDown",
      "ArrowUp",
      "Home",
      "End",
      "ArrowRight",
      "ArrowLeft",
      "Enter",
      "Space",
      "Escape",
      "Tab",
      "typeahead"
    ],
    "focus": "Rows rendered from entries carry menuitem, menuitemcheckbox or menuitemradio with aria-checked, and aria-haspopup/aria-expanded for a submenu; one roving tab stop. Opened through openFor(): the anchor gets aria-haspopup=menu and aria-expanded; Escape closes one level and returns the focus to its row or the anchor; Tab closes the whole chain; a letter moves to the next item it starts. A host that renders the menu itself owns opening, Escape/Tab dismissal and focus return, as before."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "ru",
      "en"
    ],
    "responsive": [
      "desktop",
      "mobile",
      "semantic-surface-radius",
      "unclipped-tail-with-scrollable-content",
      "logical-position-aliases",
      "forced-colors-boundary"
    ]
  },
  "adapter": {
    "kind": "generic",
    "protocol": "simai.smart-studio-adapter.v1",
    "module": null
  },
  "artifacts": {
    "fixtures": [
      "studio.fixture.json"
    ],
    "scenarios": [
      "studio.scenario.json"
    ]
  },
  "readiness": {
    "level": "described",
    "required_checks": [
      "manifest",
      "fixture",
      "runtime-upgrade",
      "scenario-smoke"
    ]
  },
  "compatibility": {
