  "ai_guidance": {
    "use_when": "Use sf-context-menu for every action menu: give it entries and open it with openFor(anchor). It opens below and start-aligned by default, with no tail, in the top layer, on the profile menu's surface. The tail (position) is for a host-placed menu that points at something.",
    "do_not": [
      "Do not copy generated ui-smart code",
      "Do not move host data or access decisions into the component",
      "Do not use physical left/right position values in new direction-neutral markup",
      "Do not hand-make a menu of divs and buttons: the row geometry, roles, keyboard and focus return are this component's",
      "Do not set position on a menu opened by openFor(); it draws a tail"
    ],
    "required_reads": [
      "inputs",
      "methods",
      "events",
      "ownership",
      "provenance"
    ],
    "minimal_example": "<button id=\"more\" type=\"button\">Ещё</button><sf-context-menu id=\"menu\" popup aria-label=\"Действия\"></sf-context-menu><script>menu.entries=[{id:\"rename\",text:\"Переименовать\",icon:\"edit\"},{type:\"separator\"},{id:\"delete\",text:\"Удалить\",icon:\"delete\",danger:true}];more.onclick=()=>menu.toggleFor(more);</script>",
    "owner_commands": [
      "npm run contract:verify",
      "npm test"
    ]
  }
}
